{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomio.app/auditorium.schema.json",
  "title": "Roomio auditorium file",
  "description": "One room as a set of named areas (outlines) that are measured and coloured as one spot each. Coordinates are in any consistent unit. Version 1 files (individual seats) are also read by the app and grouped into one area per section.",
  "type": "object",
  "required": [
    "name"
  ],
  "oneOf": [
    {
      "required": [
        "areas"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        }
      }
    },
    {
      "required": [
        "seats"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        }
      }
    }
  ],
  "properties": {
    "format": {
      "const": "roomio-auditorium"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "description": "2 = areas (current). 1 = individual seats (older files, converted on import). Omit only for hand-written files."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Venue or room name shown in the app."
    },
    "units": {
      "enum": [
        "px",
        "ft",
        "in",
        "m",
        "cm",
        "mm"
      ],
      "default": "px",
      "description": "Unit of the coordinates. Informational."
    },
    "yAxis": {
      "enum": [
        "down",
        "up"
      ],
      "default": "down",
      "description": "\"down\" = screen/SVG style (y grows downward); \"up\" = CAD style (y grows upward)."
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "description": "The areas, in walk-through order.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "points"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "number"
            ],
            "description": "Unique label, e.g. \"front-left\". Readings are stored against it \u2014 keep it stable."
          },
          "name": {
            "type": "string",
            "description": "Shown on the map. Default: the id."
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "maxItems": 1000,
            "items": {
              "type": "array",
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "The outline: corners as [x, y], in order around the edge."
          },
          "z": {
            "type": "number",
            "description": "Height (optional), e.g. for balconies."
          }
        },
        "additionalProperties": true
      }
    },
    "seats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "description": "Version 1 only: individual seats, grouped into one area per section when loaded.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "number"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "section": {
            "type": "string",
            "default": "Main"
          }
        },
        "additionalProperties": true
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "default": "Stage"
        }
      },
      "description": "Centre front of the stage (shown on the map for orientation)."
    },
    "foh": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Booth width (optional; with d, the booth is drawn to scale, centred on x,y)."
        },
        "d": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Booth depth (optional)."
        }
      },
      "description": "Suggested FOH mix position (can be moved in the app)."
    },
    "background": {
      "type": "object",
      "required": [
        "image",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^data:image/(svg\\+xml|png|jpeg|webp);base64,",
          "description": "Floor plan as a data URI, max 25 MB."
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Optional floor-plan drawing placed under the areas, in the room's coordinates (x,y = top-left for yAxis down; bottom-left for yAxis up)."
    }
  },
  "additionalProperties": true
}
