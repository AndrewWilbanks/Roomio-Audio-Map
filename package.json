{
  "name": "roomio",
  "productName": "Roomio",
  "version": "0.1.0",
  "description": "Seat-by-seat SPL, low-end and frequency-response maps of an auditorium, referenced live to Smaart at FOH.",
  "main": "main/main.js",
  "author": "Roomio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "e2e": "node dev/e2e-setup.js && node dev/e2e-live.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist": "electron-builder --mac --win --publish never",
    "release": "electron-builder --mac --win --publish always"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewWilbanks/Roomio-Audio-Map.git"
  },
  "build": {
    "appId": "app.roomio.desktop",
    "productName": "Roomio",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "renderer/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Roomio-${version}-mac-universal.${ext}"
    },
    "dmg": {
      "title": "Roomio ${version}",
      "artifactName": "Roomio-${version}-mac-universal.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Roomio-${version}-win-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Roomio",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AndrewWilbanks",
        "repo": "Roomio-Audio-Map",
        "releaseType": "draft"
      }
    ]
  }
}